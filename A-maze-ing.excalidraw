      "isDeleted": false,
      "boundElements": [],
      "updated": 1785782813925,
      "link": null,
      "locked": false,
      "text": "Her bir hücreyi 4 yönünden dolayı 4 bit olarak\ndüşünüyoruz. Duvar bulunan yönler 1, duvarı olmayan\nyönler 0 olacak şekilde.",
      "fontSize": 16,
