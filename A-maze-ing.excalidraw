      "text": "Nasıl Perfect'i bozduk?",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nasıl Perfect'i bozduk?",
