    },
    {
      "id": "VO3UnGEqal8vG61wrzjH2",
      "type": "text",
      "x": 916.0723038574436,
      "y": -450.05191346533945,
      "width": 402.3662090302096,
      "height": 240,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1w",
      "roundness": null,
      "seed": 587979582,
      "version": 2397,
      "versionNonce": 726594871,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785782813925,
      "link": null,
      "locked": false,
      "text": "Bizden labirentin ortasında bir 42 deseni yapılması\nisteniyor. Bu desenin duvarları tamamen kapalı\nşekilde olması gerekiyor. Yani bu desenin hücrelerini\nsayısal 15 değerinde bırakmamız gerekiyor.\n\nBunu sağlamak için DFS algoritmasında zaten\nişleyeceğimiz bir visited mantığımız var. Uğranan\nhücreye tekrar uğranamaması için.\n\nBu mantığı bu desenin denk geleceği yerleri\nalgoritma başlamadan önce visited yaparak\nalgoritmanın uğramamasını sağlıyoruz",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bizden labirentin ortasında bir 42 deseni yapılması isteniyor. Bu desenin duvarları tamamen kapalı şekilde olması gerekiyor. Yani bu desenin hücrelerini sayısal 15 değerinde bırakmamız gerekiyor.\n\nBunu sağlamak için DFS algoritmasında zaten işleyeceğimiz bir visited mantığımız var. Uğranan hücreye tekrar uğranamaması için.\n\nBu mantığı bu desenin denk geleceği yerleri algoritma başlamadan önce visited yaparak algoritmanın uğramamasını sağlıyoruz",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "-M4Q6mS_txgZw39o2bAWX",
      "type": "rectangle",
      "x": 889.9941742537383,
      "y": -495.75541376292256,
      "width": 466.6687326480352,
      "height": 298.83091122217047,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
