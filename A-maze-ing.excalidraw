      "boundElements": [],
      "updated": 1785782838421,
      "link": null,
      "locked": false,
      "text": "Kuyruk yapısından ötürü bir aşamdaki tüm hücrelere\nuğranmadan diğer aşamaya geçiş mümkün değildir.\nBundan dolayı olabilecek en az adımda olan yolu\nbulacağı garantidir.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Kuyruk yapısından ötürü bir aşamdaki tüm hücrelere uğranmadan diğer aşamaya geçiş mümkün değildir. Bundan dolayı olabilecek en az adımda olan yolu bulacağı garantidir.",
      "autoResize": false,
      "lineHeight": 1.25
    },
