    {
      "id": "asIZdKWvbaq7yOOSV5aGl",
      "type": "text",
      "x": 924.8130242306037,
      "y": 617.4474181298364,
      "width": 402.3662090302096,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1j",
      "roundness": null,
      "seed": 1254053630,
      "version": 1680,
      "versionNonce": 1067086073,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785782824906,
      "link": null,
      "locked": false,
      "text": "Çıkmazları (dead-end) keşfediyoruz. Dead-end'in\ndeğerleri 7,11,13 ve 14 olabilir. Yani sadece tek\nduvarı kırık olan kareler. Bu keşfettiğimiz duvarların\nherhangi bir duvarını kırıyoruz. Bir çıkmazı başka bir\nyola bağladığımızda artık bir döngü oluşturmuş\noluruz.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Çıkmazları (dead-end) keşfediyoruz. Dead-end'in değerleri 7,11,13 ve 14 olabilir. Yani sadece tek duvarı kırık olan kareler. Bu keşfettiğimiz duvarların herhangi bir duvarını kırıyoruz. Bir çıkmazı başka bir yola bağladığımızda artık bir döngü oluşturmuş oluruz.",
      "autoResize": false,
      "lineHeight": 1.25
    },
