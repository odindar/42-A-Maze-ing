      "lineHeight": 1.25
    },
    {
      "id": "0vX5dS1NTvZPuUT-pqLg8",
      "type": "text",
      "x": 223.64067527759715,
      "y": 1070.8470522518282,
      "width": 402.3662090302096,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2D",
      "roundness": null,
      "seed": 1365279353,
      "version": 2107,
      "versionNonce": 1812769975,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785782838419,
      "link": null,
      "locked": false,
      "text": "Bu algoritmada bir kuyruk(deque) yapısı\nkullanacağuız. Yine bir kareden başlıyoruz ve bunu\nvisited olarak işaretliyoruz. Sonrasında\nbulunduğumuz karenin tüm mümkün komşularını sıraya\nekliyoruz. \n\nSonra tekrar listenin solundan yani ilk FIFO'dan\ndolayı ilk gireni alıp bakıyoruz eğer çıkış noktasıysa\nburaya kadarki yolu return ediyoruz eğer değilse\nyine mümkün komşularını sıraya ekliyoruz.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bu algoritmada bir kuyruk(deque) yapısı kullanacağuız. Yine bir kareden başlıyoruz ve bunu visited olarak işaretliyoruz. Sonrasında bulunduğumuz karenin tüm mümkün komşularını sıraya ekliyoruz. \n\nSonra tekrar listenin solundan yani ilk FIFO'dan dolayı ilk gireni alıp bakıyoruz eğer çıkış noktasıysa buraya kadarki yolu return ediyoruz eğer değilse yine mümkün komşularını sıraya ekliyoruz.",
      "autoResize": false,
      "lineHeight": 1.25
    },
