    {
      "id": "Qtd8hiFpQS4F-hYKqyIPP",
      "type": "text",
      "x": 219.9725355780178,
      "y": 113.03874821226145,
      "width": 402.3662090302096,
      "height": 260,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aD",
      "roundness": null,
      "seed": 1895485410,
      "version": 1246,
      "versionNonce": 1269658622,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785774264715,
      "link": null,
      "locked": false,
      "text": "Bir kareden gezintiye başlar. Bu kareyi stack'e\nekler. Sonrasında o karenin komşularını keşfeder.\nHerhangi bir komşunu seçer. O komşuya geçmek için\ngerekli olan duvarı çift taraflı olarak yıkar. Yeni\ngeçtiği düğümü de stack'e ekler. Ayrıca gezindiğimiz\nher kareyi visited olarak işaretleyerek döngüye\ngirmeyi engelleriz. Vardığımız bir karede geçebileceği\nherhangi bir komşusu kalmazsa stack sayesinde bir\nönceki(veya geçilebilecek komşusu olan bir kareye\ngelene kadar) adıma geri döner ve oradaki başka bir\nkomşuyu seçer aynı döngüyü devam ettiririz.\nStackte herhangi bir eleman kalmazsa döngü ve\nalgoritma biter.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bir kareden gezintiye başlar. Bu kareyi stack'e ekler. Sonrasında o karenin komşularını keşfeder. Herhangi bir komşunu seçer. O komşuya geçmek için gerekli olan duvarı çift taraflı olarak yıkar. Yeni geçtiği düğümü de stack'e ekler. Ayrıca gezindiğimiz her kareyi visited olarak işaretleyerek döngüye girmeyi engelleriz. Vardığımız bir karede geçebileceği herhangi bir komşusu kalmazsa stack sayesinde bir önceki(veya geçilebilecek komşusu olan bir kareye gelene kadar) adıma geri döner ve oradaki başka bir komşuyu seçer aynı döngüyü devam ettiririz. Stackte herhangi bir eleman kalmazsa döngü ve algoritma biter.",
      "autoResize": false,
      "lineHeight": 1.25
    },
